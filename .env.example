DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
DB_URL=jdbc:postgresql://localhost:5432/travel_agent
DB_USERNAME=travel
DB_PASSWORD=
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_VERSION=v1
KNOWLEDGE_IMPORT=false
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.5
RAG_QUERY_REWRITE=true
SEARCH_API_KEY=
MCP_ENABLED=false
MCP_SERVERS_CONFIG=file:./config/mcp-servers.local.json
AMAP_MAPS_API_KEY=
PEXELS_API_KEY=

# 保守估算以 UTF-8 字节计，服务商实际 Token 单独记录
CONTEXT_TOKENS=16000
OUTPUT_TOKENS=1600
RUN_TOKEN_BUDGET=50000
RUN_TIMEOUT_SECONDS=180
REQUESTS_PER_HOUR=40
# 仅填写已审核的只读工具名称，逗号分隔；留空不向模型开放 MCP 工具
MCP_ALLOWED_TOOLS=
